# Copy this file to .env (same directory as docker-compose.yml) and fill in
# real values before running `docker compose up`. .env is gitignored — never
# commit it. Every value below with no inline default in docker-compose.yml
# is REQUIRED; the stack will fail to start without it.

# ---- MySQL ----
# Root password for the MySQL container itself (used only for the
# healthcheck and admin access — the application connects as DB_USERNAME,
# never as root).
MYSQL_ROOT_PASSWORD=changeme-root-password

# Application database — MYSQL_DATABASE/MYSQL_USER/MYSQL_PASSWORD on the
# mysql container are seeded from these same three values on first start.
DB_NAME=helpdesk
DB_USERNAME=helpdesk_app
DB_PASSWORD=changeme-app-password

# Optional: host port MySQL is published on (container always listens on
# 3306 internally regardless). Change if 3306 is already taken locally.
MYSQL_PORT=3306

# ---- Backend (Spring Boot, "docker" profile) ----
# HS512 signing secret — must be at least 64 bytes/characters long
# (JwtServiceImpl enforces this at startup). Generate one instead of using
# any example value verbatim, e.g.: openssl rand -base64 64
JWT_SECRET=changeme-jwt-secret-must-be-at-least-64-characters-long-for-hs512

# Bootstrap administrator account, seeded once on first startup if no
# users exist yet. Same dev-shaped defaults application-dev.yml uses if left
# unset — change these for anything beyond a local/throwaway container.
ADMIN_BOOTSTRAP_EMAIL=admin@helpdesk.local
ADMIN_BOOTSTRAP_PASSWORD=Dev0nly!AdminBootstrapPassword

# Optional: host port the backend is published on. Default: 8080.
BACKEND_PORT=8080

# Optional overrides — default to http://localhost:3000 / :8080 (matching
# FRONTEND_PORT/BACKEND_PORT's own defaults below) if left unset. Compose
# does not recursively expand a variable referenced inside another
# variable's default, so if you change FRONTEND_PORT or BACKEND_PORT above,
# uncomment and update these to match — they will NOT update automatically.
# CORS_ALLOWED_ORIGINS=http://localhost:3000
# API_SERVER_URL=http://localhost:8080

# ---- Frontend (nginx) ----
# Optional: host port the frontend is published on. Default: 3000.
FRONTEND_PORT=3000

# Optional override — defaults to http://localhost:8080/api/v1 (matching
# BACKEND_PORT's own default) if left unset. Same caveat as
# CORS_ALLOWED_ORIGINS/API_SERVER_URL above: update this manually if you
# change BACKEND_PORT.
# API_BASE_URL=http://localhost:8080/api/v1
